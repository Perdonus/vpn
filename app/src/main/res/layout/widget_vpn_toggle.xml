<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_toggle_background"
    android:padding="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_toggle_inner_background"
        android:foregroundGravity="center"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/widget_toggle"
                android:scaleType="centerInside"
                android:src="@drawable/ic_power" />

            <TextView
                android:id="@+id/widget_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/unbounded_medium"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/widget_state_off"
                android:textColor="@android:color/white"
                android:textSize="9sp" />

        </LinearLayout>

    </FrameLayout>

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:alpha="0"
        android:text="@string/app_name" />

</FrameLayout>
